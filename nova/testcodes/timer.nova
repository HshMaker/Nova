// 세상의 구조 때문에 생기는 
// 0 ~ 0.99초 정도의 오차가 
// 있을 수 있습니다.

var timer: int = 0

repeat (true) then
    var temp = utils.toInt(terminal.write("타이머를 설정해주세요.(초): "))

    timer = temp
    out
end

var first: int = time.now()
var last: int = first + timer

var isLogged: bool = false

repeat (timer >= 0) then
    if (isLogged) then
        if (first != time.now()) then
            first = time.now()
            isLogged = false
        end
        
        next
    end
    terminal.log(timer)
    isLogged = true
    timer = timer - 1
end
